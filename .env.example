# atrium-alto-postprocess — the published environment contract (atrium-project#60).
#
# Copy to `.env` and edit. Do not commit `.env` (gitignored at .gitignore:18).
#
# This file is the COMPLETE ledger: every variable the api image reads, at the
# default that is in the CODE. The operator-facing subset across all five services is
# the table in the hub's docs/k8s_deployment.md; this file's layout is fixed by
# docs/templates/env.example.template in ufal/atrium-project.
#
# TAG LEGEND: [required] raises at startup without it · [secret] never a literal
# anywhere committed, use a k8s Secret · [operator] an ordinary deployment knob ·
# [algorithmic] changes what the service COMPUTES, not how it is deployed ·
# [build] read by compose/Dockerfile or baked at build time
#
# HOW THIS FILE REACHES THE PROCESS
#   docker compose  → delivered. docker-compose.yml's `api` service declares
#                     `env_file: .env`, so everything below is injected into the
#                     container. Two names (ALLOWED_ORIGINS, PORT) are ALSO named
#                     explicitly in the `environment:` block, because they need a
#                     value different from a bare pass-through (compose's own
#                     narrower ALLOWED_ORIGINS default — see below) or because
#                     compose itself needs the value (PORT, for the `ports:`
#                     mapping).
#   Kubernetes      → NOT delivered. Use the manifest's own env: block. See
#                     ufal/atrium-project docs/k8s_deployment.md.
#   python service/text_api.py
#                   → NOT delivered. Nothing here calls load_dotenv(); export the
#                     values yourself:  set -a; . ./.env; set +a
#
# BLANK IS NOT UNIVERSALLY "UNSET". ALLOWED_ORIGINS is the trap: a blank value parses
# to an EMPTY origin list and blocks every browser request, where omitting the line
# gives you `*` — so it ships commented below, not blank. Every [limit] below treats a
# blank value as unset (atrium-project#53); a MALFORMED one (`ten`, a negative) stops
# the service at startup, naming the variable.

# ── §0 Required before first start ─────────────────────────────────────────────
# None — this service starts with no variables set.

# ── §1 HTTP surface ─────────────────────────────────────────────────────────────
# [operator] Port the api service binds, and the port service/healthcheck.py probes
# inside the container. docker-compose.yml maps "${PORT:-8000}:${PORT:-8000}", so
# changing it here moves listener, published port and HEALTHCHECK together. In
# Kubernetes, change `containerPort` in the same edit. (atrium-project#58)
PORT=8000
# [operator] Bind address. Leave at 0.0.0.0. service/healthcheck.py always probes
# 127.0.0.1 by design and never reads HOST, so 127.0.0.1 here gives a container that
# reports HEALTHY to every probe while being unreachable from outside it. This is the
# one value whose failure mode is silent.
# HOST=0.0.0.0
# [operator] CSV of CORS origins. Code default `*` (every origin) —
# service/atrium_service.py:370 falls back to it when unset. docker-compose.yml
# supplies its own narrower default (http://localhost:8080,http://localhost:5500),
# which applies ONLY under compose; note page-classification spells loopback
# differently (127.0.0.1) in its own compose default, and `localhost` and
# `127.0.0.1` are DIFFERENT origins to a browser. Kubernetes never reads
# docker-compose.yml, so a k8s deployment that omits this runs `*`. Ships commented
# so an operator who leaves it alone gets the real code default under compose;
# uncomment to change it.
# ALLOWED_ORIGINS=*
# [limit] Canonical upload limit in megabytes, per uploaded part (the file and the
# document record). 25 is THIS repo's built-in (tool_limits.py, `upload_limit(25)`); the
# five services do not share one value — alto 25, llm-enrich 10, nlp-enrich 5,
# page-classification 10, translator 50. Over it → 413 limit_exceeded. Default: 25.
MAX_UPLOAD_MB=25
# [deprecated] Do not set. A byte-valued fallback kept working for one release for
# callers that already exported it (strategy §4.5); MAX_UPLOAD_MB wins whenever both
# are present (service/atrium_service.py:353-364). Listed commented-out so the
# contract is complete and the deprecation is discoverable.
# MAX_UPLOAD_BYTES=
# [operator] Path the container's own HEALTHCHECK probes. Change it only alongside
# the route itself.
# HEALTHCHECK_PATH=/health

# ── §2 Lifecycle ────────────────────────────────────────────────────────────────
# [operator] Seconds uvicorn waits for in-flight requests on SIGTERM. Raise together
# with the deployment's grace period (terminationGracePeriodSeconds in k8s, see
# docs/k8s_deployment.md in the hub; stop_grace_period under compose, already 60s
# here).
GRACEFUL_SHUTDOWN_S=20
# [operator] Root logger level for the `python service/text_api.py` start path. All
# five services honour it identically (atrium-project#61).
LOG_LEVEL=INFO
# [operator] Filesystem auto-reload. Development only — never in a deployment.
# Deliberately NOT wired into any compose or k8s template.
# RELOAD=false

# ── §3 Backing services (atrium-project#63) ─────────────────────────────────────
# None — this service calls no attachable backing service. (`KOREKTOR_URL`, read by
# `tools/quality_model/correct.py`, is a batch/tools-layer script the api entrypoint's
# import closure does not reach — see §6.)

# ── §4 Image / provenance ────────────────────────────────────────────────────────
# [build] Image tag used by docker-compose (matches para_config.txt [tool] version on
# release). Read only by docker-compose.yml; no Python here reads it.
ATRIUM_VERSION=dev
# [build] Baked at build time; stamped into paradata as runner_ref.
ATRIUM_RUNNER_REF=dev
# [build] Override either only if you publish under another name.
# ATRIUM_RUNNER_IMAGE=ghcr.io/ufal/atrium-alto-postprocess:dev-api
# ATRIUM_RUNNER_REPO=https://github.com/ufal/atrium-alto-postprocess
# [build] Correlation id copied verbatim into paradata `request_id`. Read ONCE from
# the process environment at import (atrium_paradata.py's module-level constants),
# so it identifies a batch run, not an individual HTTP request.
# ATRIUM_REQUEST_ID=
# [build] Where the HuggingFace model cache lives. The Dockerfile sets this and
# docker-compose.yml mounts a named volume at it; without the volume the cache is
# re-downloaded on every start.
# HF_HOME=/cache/huggingface

# ── §5 Service knobs — operator ──────────────────────────────────────────────────
# [operator] Directory models are loaded from — the FastText language-ID model
# (lid.176.bin) lives here, seeded from the image on first run and persisted by the
# alto-models volume. Rule 3: the real default is computed from the repo root, so a
# literal here would freeze a path only correct for one working directory. Point
# this at a mounted volume in any deployment that should persist the model across
# restarts.
# MODEL_DIR=<repo>/models
# [operator] Language-ID config, when mounted from a ConfigMap instead of the
# image's own setup/config.txt. Rule 3: computed from the repo root at runtime.
# Shares its two-incompatible-default-shape quirk with LANGID_CONFIG reads
# elsewhere in this repo (batch layer, out of #60's scope) — this is the
# service-layer read only, from service/text_inference.py. (#31) The service reads
# [CLASSIFY] languages, [TEXT_INGEST] reader settings and [DOCUMENT].SOURCE_ORIGIN
# (_BY_KIND) from this file, once at start-up.
# LANGID_CONFIG=<repo>/setup/config.txt
# [operator] Where document.json output is written. No code default at all — unset
# means the feature is off.
# DOCUMENT_JSON_DIR=
#
# Limits (atrium-project#53) — every limit of this service except MAX_UPLOAD_MB (§1),
# declared in tool_limits.py, reported with its current value in GET /info (`limits`;
# `limits_meta` names the variable and whether the value came from the environment, the
# config file or the default), and listed in service/README.md's `## Limits` table. A
# limit that shaped a result without refusing it is returned in the response's
# `limits_applied` and recorded in the paradata.
#
# The [TEXT_INGEST] caps. Each is ALSO a key of the LANGID_CONFIG file (setup/config.txt
# [TEXT_INGEST]), which the batch pipeline reads; the variable here wins over the file,
# the file over the built-in default. Rule 3: they ship COMMENTED — an active line would
# be copied into .env by CI and override the config file silently. The default given is
# the built-in one, which the shipped config.txt also uses.
#
# [limit] Largest file, or decompressed stream, a reader takes. Over it → 413
# limit_exceeded (code too_large); a ZIP-bundle member over it is skipped instead, with a
# `skipped` note. Default: 256 (config key MAX_FILE_MB).
# ATRIUM_TEXT_INGEST_MAX_FILE_MB=256
# [limit] Most members a ZIP container may have. Over it → 413 limit_exceeded (code
# zip_limits_exceeded). Default: 10000 (config key ZIP_MAX_MEMBERS).
# ATRIUM_TEXT_INGEST_ZIP_MAX_MEMBERS=10000
# [limit] Most a ZIP container may unpack to in total, MB. Over it → 413 limit_exceeded.
# Default: 1024 (config key ZIP_MAX_TOTAL_MB).
# ATRIUM_TEXT_INGEST_ZIP_MAX_TOTAL_MB=1024
# [limit] Largest single ZIP member unpacked, MB. Over it → 413 limit_exceeded.
# Default: 256 (config key ZIP_MAX_MEMBER_MB).
# ATRIUM_TEXT_INGEST_ZIP_MAX_MEMBER_MB=256
# [limit] Highest compression ratio of a ZIP member (over 1 MiB) or a gz/bz2/xz stream.
# Over it → 413 limit_exceeded. Default: 200 (config key ZIP_MAX_RATIO).
# ATRIUM_TEXT_INGEST_ZIP_MAX_RATIO=200
# [limit] Most pages a document may have. Over it → 413 limit_exceeded (code too_large).
# Default: 20000 (config key MAX_PAGES).
# ATRIUM_TEXT_INGEST_MAX_PAGES=20000
# [limit] Most lines one page may have. A paged format (PDF, ALTO, PAGE, hOCR, ABBYY,
# DjVu, Tesseract TSV) over it → 413 limit_exceeded; any other format is split onto
# continuation pages and read in full, with a `split` note. Default: 100000 (config key
# MAX_LINES_PER_PAGE).
# ATRIUM_TEXT_INGEST_MAX_LINES_PER_PAGE=100000
# [limit] Seconds the isolated PDF reader may take. Over it → 422 limit_exceeded (code
# timeout) — a per-input budget, so a retry will not help. Default: 300 (config key
# READER_TIMEOUT_S).
# ATRIUM_TEXT_INGEST_READER_TIMEOUT_S=300
# [limit] Longest line in characters; a longer one is wrapped at a word boundary and
# classified in full as several lines, with a `split` note (0 = never wrap). Default:
# 1000 (config key MAX_LINE_CHARS).
# ATRIUM_TEXT_INGEST_MAX_LINE_CHARS=1000
#
# [limit] Most repeats of one ODS/ODT cell or row that are read (`number-*-repeated`);
# the rest is left out, with a `trimmed` note. Default: 100.
ATRIUM_TEXT_INGEST_ODF_REPEAT_CAP=100
# [limit] Most objects of one PDF page scanned to judge its text layer (its text is always
# read in full); a page with more is judged on the first N, with a `sampled` note.
# Default: 20000.
ATRIUM_TEXT_INGEST_PDF_OBJECT_CAP=20000
# [limit] Lines per LayoutReader window when predicting an ALTO page's reading order; a
# longer page is ordered window by window, with a `split` note. Default: 350.
LR_CHUNK_SIZE=350
# [limit] Smallest window the out-of-memory fallback halves down to; below it the page
# keeps its document order, with a `skipped` note. Default: 50.
LR_MIN_CHUNK_SIZE=50
# [limit] Lines per perplexity forward pass (one batch is padded to its longest line). A
# batch that fails scores its lines 99999, with a `skipped` note. Default: 128.
PPL_BATCH_LINES=128

# ── §6 Completeness ledger — algorithmic, deprecated, unreachable ────────────────
# [algorithmic] Quality-estimation perplexity model. Changes what the service
# COMPUTES (which model scores line quality), not how it is deployed — override for
# an English-only collection (e.g. distilgpt2), not to tune throughput.
# GPT2_MODEL_NAME=Qwen/Qwen2.5-0.5B
# [algorithmic] LayoutReader model used to reorder tokens by 2D spatial layout.
# LAYOUT_MODEL_PATH=hantian/layoutreader
# (LR_CHUNK_SIZE and LR_MIN_CHUNK_SIZE, issue #8, are limits since atrium-project#53 —
# see §5 "Limits".)
#
# [algorithmic] ~95 quality/classification-scoring constants read at import time
# by text_util.py via a section+key composed name — ATRIUM_TEXT_UTILS_* (line/text
# quality heuristics: perplexity thresholds, vowel-ratio weights, rotation and
# garbage-detection cutoffs, ...) and ATRIUM_CLASSIFY_* (a handful of language-
# remapping/trust knobs). Each overrides one scalar in setup/config.txt, which is
# the real place to tune them — they change what the service COMPUTES, not how it
# is deployed, so they are not enumerated here one by one (atrium-project#60/#53:
# "not in scope: converting every algorithmic parameter to an env var"). Declared
# as a family in tests/env_contract_data.py's NOT_PUBLISHED so this ledger's
# COMPLETE-ledger claim above stays checked, not just asserted — see
# ATRIUM_TEXT_UTILS_* / ATRIUM_CLASSIFY_* there for the full reasoning.
