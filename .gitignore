# Paradata emitted by local runs. The handful of sample logs already committed
# under paradata/ stay tracked (gitignore does not untrack tracked files) —
# this only stops every local pipeline run from showing up as untracked noise.
paradata/*.json
# ./data is the compose bind mount; the directory is committed (data/.gitkeep) so a
# clone owns it, and everything a run writes into it stays untracked. (atrium-project#69)
/data/*
!/data/.gitkeep
